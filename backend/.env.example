# LLM backend for the live path (claims that aren't in the curated DB).
#   ollama    = local LLM (default, free). Needs an Ollama server -> see below
#   anthropic = Claude API (paid). Requires ANTHROPIC_API_KEY
#   none      = disable the live path (curated DB only)
HEALTHLENS_LLM_BACKEND=ollama

# --- Ollama (local) ---
OLLAMA_URL=http://localhost:11434
HEALTHLENS_OLLAMA_MODEL=qwen3:8b
# The default qwen3:8b favors quality - clean Korean, accurate verdicts, ~1 min per video.
# For speed: qwen2.5:7b (slightly worse, faster).  Lighter still: qwen2.5:3b.

# --- Anthropic (only when HEALTHLENS_LLM_BACKEND=anthropic) ---
ANTHROPIC_API_KEY=
HEALTHLENS_MODEL=claude-haiku-4-5

# --- Optional: NCBI E-utilities key (raises the PubMed rate limit) ---
NCBI_API_KEY=
