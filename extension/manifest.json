{
  "manifest_version": 3,
  "name": "HealthLens — 건강정보 문해력 도우미",
  "version": "0.1.0",
  "description": "유튜브 건강 주장에 대한 지지·반대 근거를 대칭으로 정리해 스스로 판단하도록 돕습니다.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
